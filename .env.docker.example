# Okidoc production settings for docker compose.
#   cp .env.docker.example .env   — then fill in every "change-me" value. Never commit .env.
# Generate secrets with:  openssl rand -hex 32

# ---- Public addresses (what browsers and the phone app use) ----
# API, as reached from outside (behind your HTTPS reverse proxy). Baked into the web build.
PUBLIC_API_URL=https://api.example.in
# Used in links and QR codes the API generates (clinic posters). Usually the same as PUBLIC_API_URL.
PUBLIC_BASE_URL=https://api.example.in
# Web origins allowed to call the API (comma-separated): the website / console address.
CORS_ORIGINS=https://okidoc.example.in

# ---- Host ports. 127.0.0.1 = only reachable through a reverse proxy on this server (recommended).
# Set to 0.0.0.0 to open them directly, e.g. for a first test on a private network.
API_BIND=127.0.0.1
API_PORT=4000
WEB_BIND=127.0.0.1
WEB_PORT=3000

# ---- Database ----
POSTGRES_PASSWORD=change-me

# ---- Auth (the API refuses to start in production without these) ----
JWT_ACCESS_SECRET=change-me
JWT_SETUP_SECRET=change-me
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# ---- Messaging ----
# console = OTPs and SMS are only written to the API log. Set a real provider before real users sign up.
SMS_PROVIDER=console
# SMS_PROVIDER=msg91
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_GENERIC=
# MSG91_WHATSAPP_NUMBER=
PUSH_PROVIDER=expo
# Path inside the container; mount the file in docker-compose.yml (see the api volumes there).
# FCM_SERVICE_ACCOUNT_JSON=/run/secrets/fcm.json

# ---- Payments (mock = simulated) ----
PAYMENT_GATEWAY=mock
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# ---- AI Assistant (optional; without a key it uses the rule-based specialty matcher) ----
# ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5

# ---- Scheduled jobs (reminders, auto-ending sittings, no-show sweep). Keep true on exactly one API container.
JOBS_ENABLED=true

# ---- First-time seed (docker compose run --rm api node prisma/dist/seed.js) ----
# false = reference data (areas, specialties, plans, settings) + the admin below, no demo accounts.
SEED_DEMO=false
ADMIN_PHONE=
ADMIN_PASSWORD=
ADMIN_NAME=Okidoc Admin
ADMIN_EMAIL=
