# ---- Core ----
PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://okidoc:okidoc@localhost:5433/okidoc
# Comma-separated list of allowed web origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
PUBLIC_BASE_URL=http://localhost:4000

# ---- Auth ----
JWT_ACCESS_SECRET=change-me-access
JWT_SETUP_SECRET=change-me-setup
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Echo OTP codes in API responses (local development ONLY — never enable in production)
OTP_DEV_ECHO=true

# ---- Messaging (console = log to terminal) ----
SMS_PROVIDER=console
# MSG91_AUTH_KEY=
# MSG91_SENDER_ID=OKIDOC
# GUPSHUP_API_KEY=
# Mobile push: the bare RN app sends FCM tokens (prefixed fcm:). Set the Firebase service account
# (JSON string or path to the downloaded .json) to deliver them via FCM HTTP v1.
# FCM_SERVICE_ACCOUNT_JSON=./firebase-service-account.json
# Legacy Expo push tokens are still delivered via the Expo push service.
PUSH_PROVIDER=expo

# ---- Payments (mock = simulated gateway for development) ----
PAYMENT_GATEWAY=mock
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# ---- File storage (local disk in dev) ----
STORAGE_DIR=./uploads

# ---- AI Assistant (Phase 1.5). Without a key the Assistant uses the rule-based specialty matcher. ----
# ANTHROPIC_API_KEY=
# Default claude-opus-5-5. For lower cost on this simple classification task you can set claude-haiku-5-5.
ASSISTANT_MODEL=claude-opus-5-5

# ---- Optional Redis (multi-node socket fan-out). Not required for local dev. ----
# REDIS_URL=redis://localhost:6379
