    android:height="240dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M40,26h28a14,14 0,0 1,14 14v28a14,14 0,0 1,-14 14h-28a14,14 0,0 1,-14 -14v-28a14,14 0,0 1,14 -14z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="26" android:startY="26"
                android:endX="82" android:endY="82">
                <item android:offset="0" android:color="#FF2DD4BF" />
                <item android:offset="0.5" android:color="#FF14B8A6" />
                <item android:offset="1" android:color="#FF0A766C" />
            </gradient>
        </aapt:attr>
    </path>
    <group
        android:scaleX="0.82"
        android:scaleY="0.82"
        android:translateX="27.76"
        android:translateY="27.76">
        <path
            android:pathData="M15,29a14,14 0,1 0,28 0a14,14 0,1 0,-28 0"
            android:strokeWidth="6"
            android:strokeColor="#FFFFFFFF"
            android:fillColor="#00000000" />
        <path
