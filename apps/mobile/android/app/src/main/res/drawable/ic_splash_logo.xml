            android:strokeLineCap="round"
            android:strokeColor="#FFFFFFFF" />
        <path
            android:pathData="M20.5,29h4.5l2.2,-4.6l4,9.2l2.2,-4.6h4.6"
            android:strokeWidth="2.7"
            android:strokeLineCap="round"
