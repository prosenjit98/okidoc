{
  "name": "@okidoc/mobile",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "react-native start --port 8088",
    "android": "react-native run-android --port 8088",
    "ios": "react-native run-ios --port 8088",
    "typecheck": "tsc --noEmit",
    "bundle:android": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output build/index.android.bundle --assets-dest build/android-assets",
    "bundle:ios": "react-native bundle --platform ios --dev false --entry-file index.js --bundle-output build/main.jsbundle --assets-dest build/ios-assets"
  },
  "dependencies": {
    "@okidoc/shared": "*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native-documents/picker": "^12.1.0",
    "@react-native-firebase/app": "^27.1.1",
    "@react-native-firebase/messaging": "^27.1.1",
    "@react-native-vector-icons/ionicons": "^14.0.0",
    "@react-navigation/bottom-tabs": "^7.22.0",
    "@react-navigation/native": "^7.5.2",
    "@react-navigation/native-stack": "^7.21.1",
    "@tanstack/react-query": "^5.108.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-blob-util": "^1.1.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-get-random-values": "^2.1.0",
    "react-native-google-mobile-ads": "^17.4.0",
    "react-native-image-picker": "^8.3.0",
    "react-native-keychain": "^11.0.0",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-localize": "^3.7.2",
    "react-native-nitro-image": "^0.15.2",
    "react-native-nitro-modules": "^0.37.2",
    "react-native-razorpay": "^3.0.0",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-share": "^12.3.1",
    "react-native-view-shot": "6.1.1",
    "react-native-vision-camera": "^5.2.4",
    "react-native-vision-camera-barcode-scanner": "^5.2.4",
    "react-native-webview": "14.0.1",
    "socket.io-client": "^4.8.4",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/metro-config": "0.88.1",
    "@react-native/typescript-config": "0.88.1",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
